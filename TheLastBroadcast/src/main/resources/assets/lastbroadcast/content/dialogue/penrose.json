  "skyhook": {
   "lines": [
    {
     "who": "penrose",
     "text": "A resonant array. Tune them properly and the tower and the sky behave like a single instrument."
    },
    {
     "who": "penrose",
     "text": "Fifty kilowatts, all perfectly proper. The licence is framed in Walter's office."
    }
   ],
   "choices": [

  "defensive": {
   "lines": [
    {
     "who": "penrose",
     "text": "Two hundred kilowatts? From a ghost on a monitor? You can't put a ghost in a report."
    },
    {
     "who": "penrose",
     "text": "My logs are in order. And my locker is my own business."
    }

  "confront": {
   "lines": [
    {
     "who": "penrose",
     "text": "You've read my log."
    },
    {
     "who": "player",
     "text": "Every night the ghost appeared, you had the Skyhook in overdrive. Tonight too."
    },
    {
     "who": "penrose",
     "text": "...Yes. Since September. I saw the first picture on run three and I could not stop looking."
    },
    {
     "who": "penrose",
     "text": "It's us, you see. Thursday. Every run shows the last one. Walter needs Thursday. Futura needs Thursday."
    }
   ],
   "choices": [
    {
     "text": "There's a new programme on 7-B. A bulletin from Thursday night.",
     "next": "confess2",
     "actions": [],
     "if": [],

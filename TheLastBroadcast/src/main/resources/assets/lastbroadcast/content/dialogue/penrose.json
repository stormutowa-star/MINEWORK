  "confess2": {
   "lines": [
    {
     "who": "penrose",
     "text": "A bulletin? I only ever watched the mornings. What does it show?"
    },
    {
     "who": "player",
     "text": "Dot, on the air, during a fire in your transmitter hall. At 9:14."
    },
    {
     "who": "penrose",
     "text": "So that's why it's always Thursday. It's the last run because afterwards there's nothing left to run."
    },
    {
     "who": "penrose",
     "text": "Here. The console key. Shut her down tonight, properly, and I'll cancel Thursday myself."
    }
   ],
   "choices": [
    {
     "text": "Take the key.",

  "d2": {
   "lines": [
    {
     "who": "brandt",
     "text": "Two hundred kilowatts. Look - Futura wanted a picture in Los Angeles, and Arthur said he could do it."
    },
    {
     "who": "brandt",
     "text": "I signed what he put in front of me. If that's a crime, it's the crime of keeping the lights on."
    }
   ],
   "choices": [
    {
     "text": "And the Model 63?",

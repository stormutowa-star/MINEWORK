  "thursday": {
   "lines": [
    {
     "who": "brandt",
     "text": "The Futura demonstration. Coast to coast from little Halloway Falls! That contract keeps sixty people working."
    },
    {
     "who": "brandt",
     "text": "Within our licence, naturally."

  "small": {
   "lines": [
    {
     "who": "brandt",
     "text": "Still here? Coffee's in the lobby. It's terrible."
    }
   ],
   "choices": [
    {
     "text": "Tell me about Thursday.",
     "next": "thursday",
     "actions": [],
     "if": [],
     "ifNot": [],
     "ifEvidence": []

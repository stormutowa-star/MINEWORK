  "dx": {
   "lines": [
    {
     "who": "brandt",
     "text": "The sixty-three? That's confidential until January. Their letter is in my cabinet. How in God's name -"
    },
    {
     "who": "brandt",
     "text": "If that goes out on my air, Futura walks. And then there is no WKVR."
    }
   ],
   "choices": [
    {
     "text": "Then don't air it.",

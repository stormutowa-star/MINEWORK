  "late": {
   "lines": [
    {
     "who": "brandt",
     "text": "Arthur came to me white as a sheet. Says you know what happens on Thursday. Do I want to know?"
    }
   ],
   "choices": [
    {
     "text": "No. You don't.",
     "next": null,

 "lines": [
  {
   "t": 1.4,
   "d": 4.2,
   "who": "dot",
   "text": "¡Es la hora del Dial de la Suerte! Los teléfonos suenan por todo el valle..."
  },
  {
   "t": 6.0,
   "d": 4.6,
   "who": "dot",
   "text": "...¡y nuestra afortunada llamante es la Sra. Eleanor Voss, de la Calle del Pino!"
  },
  {
   "t": 11.0,
   "d": 4.0,
   "who": "voss",
   "text": "¡Santo cielo! ¿Esto es de verdad la televisión?"
  },
  {
   "t": 15.5,
   "d": 5.0,
   "who": "dot",
   "text": "¡Sí lo es! Sra. Voss, ¡ha ganado una Cocina Futura - el flamante Modelo 63!"
  },
  {
   "t": 21.0,
   "d": 4.0,
   "who": "voss",
   "text": "¿Un Modelo 63? ¡No sabía que habían hecho uno!"
  },
  {
   "t": 25.5,
   "d": 4.0,
   "who": "dot",
   "text": "¡Nadie lo sabía hasta hoy! Quédese con nosotros para un primer vistazo."
  },
  {
   "t": 33.4,
   "d": 4.2,
   "who": "servo",
   "text": "BUENAS NOCHES. SOY EL NUEVO SERVO. AHORA DOBLO LA ROPA."
  },
  {
   "t": 38.0,
   "d": 5.0,
   "who": "announcer",
   "text": "Presentamos la Cocina Futura Modelo 63 - en exposición esta primavera."
  },
  {
   "t": 43.5,
   "d": 3.8,
   "who": "announcer",
   "text": "Modelo 63. Porque el mañana no puede esperar."
  },
  {
   "t": 47.6,
   "d": 3.8,
   "who": "servo",
   "text": "FUTURA. EL MAÑANA, ENTREGADO HOY."
  }

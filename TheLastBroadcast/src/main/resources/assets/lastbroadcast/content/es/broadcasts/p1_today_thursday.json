 "lines": [
  {
   "t": 1.5,
   "d": 4.5,
   "who": "dot",
   "text": "¡Buenos días, Halloway Falls! Es jueves, veinticinco de octubre..."
  },
  {
   "t": 6.2,
   "d": 4.0,
   "who": "dot",
   "text": "...¡y nos ven a todo color por primera vez!"
  },
  {
   "t": 10.6,
   "d": 4.6,
   "who": "dot",
   "text": "Mi invitado es el hombre que mantiene en el aire el Canal 7: Arthur Penrose."
  },
  {
   "t": 15.6,
   "d": 4.0,
   "who": "penrose",
   "text": "Buenos días, Dot. Buenos días, Halloway Falls."
  },
  {
   "t": 20.1,
   "d": 5.0,
   "who": "dot",
   "text": "Arthur, esta noche todo el país observa tu Skyhook. ¿Qué ocurre a las nueve?"
  },
  {
   "t": 25.5,
   "d": 5.2,
   "who": "penrose",
   "text": "A las seis de esta mañana la llevamos a plena potencia. Esta noche la mantendremos para nuestros invitados de Futura."
  },
  {
   "t": 31.0,
   "d": 4.8,
   "who": "penrose",
   "text": "Doscientos kilovatios, Dot. De costa a costa en un solo salto - rebotando en el propio cielo."
  },
  {
   "t": 36.1,
   "d": 4.0,
   "who": "dot",
   "text": "¡Doscientos! ¿Eso... está permitido?"
  },
  {
   "t": 40.5,
   "d": 5.0,
   "who": "penrose",
   "text": "¡Ja! Walter tiene los papeles en regla. Esta noche haremos historia."
  },
  {
   "t": 46.1,
   "d": 5.0,
   "who": "dot",
   "text": "Bueno, yo estaré aquí mismo, en el Estudio A, toda la noche. ¡Salúdennos, América!"
  },
  {
   "t": 51.4,
   "d": 4.8,
   "who": "dot",
   "text": "Halloway Hoy vuelve enseguida, después de este mensaje de Futura."
  }
 ],

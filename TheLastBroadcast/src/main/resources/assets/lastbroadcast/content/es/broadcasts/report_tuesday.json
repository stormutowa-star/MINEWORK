 "lines": [
  {
   "t": 2.5,
   "d": 4.6,
   "who": "hal",
   "text": "Buenas noches. Este es el Informativo del Canal 7 del martes, veintitrés de octubre."
  },
  {
   "t": 7.5,
   "d": 5.0,
   "who": "hal",
   "text": "Desde Washington esta noche: la cuarentena naval en el Caribe sigue en vigor."
  },
  {
   "t": 13.0,
   "d": 4.6,
   "who": "hal",
   "text": "Las autoridades piden a las familias que mantengan la calma y sigan con sus rutinas."
  },
  {
   "t": 18.0,
   "d": 5.0,
   "who": "hal",
   "text": "A nivel local, un frente frío llega durante la noche. Probables heladas el jueves por la mañana."
  },
  {
   "t": 23.5,
   "d": 5.0,
   "who": "hal",
   "text": "Cielos despejados el jueves por la tarde - buenas noticias para la demostración del Skyhook de WKVR."
  },
  {
   "t": 29.0,
   "d": 5.0,
   "who": "hal",
   "text": "Los invitados de Futura Corporation verán una emisión de un solo salto, de costa a costa."
  },
  {
   "t": 34.5,
   "d": 5.2,
   "who": "hal",
   "text": "El director de la emisora, Walter Brandt, asegura que la torre funcionará dentro de su potencia autorizada."
  },
  {
   "t": 40.0,
   "d": 4.8,
   "who": "hal",
   "text": "Ese fue el Informativo. Buenas noches, y mantengan sus aparatos sintonizados en el Canal 7."
  }
 ],

 "lines": [
  {
   "t": 1.0,
   "d": 4.0,
   "who": "dot",
   "text": "¡Buenos días, Halloway Falls! Hoy es martes, veintitrés de octubre."
  },
  {
   "t": 5.2,
   "d": 4.0,
   "who": "dot",
   "text": "Hace fresco, así que abriguen a los pequeños antes de que pase el autobús escolar."
  },
  {
   "t": 9.6,
   "d": 4.6,
   "who": "dot",
   "text": "La feria de la Grange abre en Delmar el sábado. Las inscripciones de tartas cierran el viernes al mediodía."
  },
  {
   "t": 14.6,
   "d": 4.8,
   "who": "dot",
   "text": "Y el jueves por la mañana, nuestro ingeniero jefe Arthur Penrose se une a mí aquí mismo..."
  },
  {
   "t": 19.8,
   "d": 4.4,
   "who": "dot",
   "text": "...para contarnos qué está cocinando su torre Skyhook para nuestra gran demostración de Futura."
  },
  {
   "t": 24.6,
   "d": 4.6,
   "who": "dot",
   "text": "El Sr. Brandt promete que todo se hará como manda el reglamento."
  },
  {
   "t": 29.6,
   "d": 5.0,
   "who": "dot",
   "text": "Y una cosa más: mañana llegan nuestras nuevas cámaras a color. ¿Pueden imaginarlo?"
  },
  {
   "t": 35.0,
   "d": 4.6,
   "who": "dot",
   "text": "Halloway Hoy, a todo color. El jueves por la mañana, a las ocho en punto."
  },
  {
   "t": 40.2,
   "d": 5.0,
   "who": "dot",
   "text": "Hasta entonces, les habla Dot Kimball: ¡mantengan su antena apuntando al mañana!"
  }
 ],

 "lines": [
  {
   "t": 2.0,
   "d": 4.8,
   "who": "hal",
   "text": "Buenas noches. El Informativo del Canal 7 del jueves, veinticinco de octubre."
  },
  {
   "t": 7.4,
   "d": 4.6,
   "who": "hal",
   "text": "Esta noche, a las nueve, la torre Skyhook de WKVR hace historia de la radiodifusión."
  },
  {
   "t": 12.5,
   "d": 5.2,
   "who": "hal",
   "text": "Desde las seis de esta mañana el Skyhook transmite nuestros programas a doscientos kilovatios..."
  },
  {
   "t": 18.0,
   "d": 4.6,
   "who": "hal",
   "text": "...cuatro veces la potencia habitual de la emisora, para nuestros invitados de Futura Corporation."
  },
  {
   "t": 23.1,
   "d": 5.0,
   "who": "hal",
   "text": "El ingeniero jefe Arthur Penrose lo llama 'la primera verdadera emisión de un solo salto'."
  },
  {
   "t": 28.5,
   "d": 4.6,
   "who": "hal",
   "text": "En Delmar, el comité de la feria de la Grange informa de récord de inscripciones para el sábado."
  },
  {
   "t": 33.5,
   "d": 5.0,
   "who": "hal",
   "text": "Y es una noche despejada y fría - perfecta, me dicen, para llegar hasta el cielo."
  },
  {
   "t": 39.1,
   "d": 5.2,
   "who": "hal",
   "text": "Permanezcan en el Canal 7 para la demostración, en vivo desde el Estudio A, a las nueve."
  }
 ],

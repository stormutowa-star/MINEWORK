 "lines": [
  {
   "t": 1.5,
   "d": 4.5,
   "who": "dot",
   "text": "Good morning, Halloway Falls! It's Thursday, October twenty-fifth..."
  },
  {
   "t": 6.2,
   "d": 4.0,
   "who": "dot",
   "text": "...and you're seeing us in living color for the very first time!"
  },
  {
   "t": 10.6,
   "d": 4.6,
   "who": "dot",
   "text": "My guest is the man who keeps Channel 7 on the air - Arthur Penrose."
  },
  {
   "t": 15.6,
   "d": 4.0,
   "who": "penrose",
   "text": "Good morning, Dot. Good morning, Halloway Falls."
  },
  {
   "t": 20.1,
   "d": 5.0,
   "who": "dot",
   "text": "Arthur, tonight the whole country is watching your Skyhook. What happens at nine?"
  },
  {
   "t": 25.5,
   "d": 5.2,
   "who": "penrose",
   "text": "At six this morning we took her to full output. Tonight we hold it for our Futura guests."
  },
  {
   "t": 31.0,
   "d": 4.8,
   "who": "penrose",
   "text": "Two hundred kilowatts, Dot. Coast to coast in a single hop - off the sky itself."
  },
  {
   "t": 36.1,
   "d": 4.0,
   "who": "dot",
   "text": "Two hundred! Is that... allowed?"
  },
  {
   "t": 40.5,
   "d": 5.0,
   "who": "penrose",
   "text": "Ha! Walter has the paperwork in hand. Tonight, we make history."
  },
  {
   "t": 46.1,
   "d": 5.0,
   "who": "dot",
   "text": "Well, I'll be right here in Studio A all evening. Wave to us, America!"
  },
  {
   "t": 51.4,
   "d": 4.8,
   "who": "dot",
   "text": "Halloway Today will be right back, after this word from Futura."
  }
 ],

 "lines": [
  {
   "t": 2.0,
   "d": 4.8,
   "who": "hal",
   "text": "Good evening. The Channel 7 Report for Thursday, October twenty-fifth."
  },
  {
   "t": 7.4,
   "d": 4.6,
   "who": "hal",
   "text": "Tonight at nine, WKVR's Skyhook tower makes broadcasting history."
  },
  {
   "t": 12.5,
   "d": 5.2,
   "who": "hal",
   "text": "Since six this morning the Skyhook has carried our programs at two hundred kilowatts..."
  },
  {
   "t": 18.0,
   "d": 4.6,
   "who": "hal",
   "text": "...four times the station's ordinary output, for our guests from Futura Corporation."
  },
  {
   "t": 23.1,
   "d": 5.0,
   "who": "hal",
   "text": "Chief engineer Arthur Penrose calls it 'the first true single-hop telecast'."
  },
  {
   "t": 28.5,
   "d": 4.6,
   "who": "hal",
   "text": "In Delmar, the Grange fair committee reports record entries for Saturday."
  },
  {
   "t": 33.5,
   "d": 5.0,
   "who": "hal",
   "text": "And it's a clear, cold night - perfect, they tell me, for reaching the sky."
  },
  {
   "t": 39.1,
   "d": 5.2,
   "who": "hal",
   "text": "Stay with Channel 7 for the demonstration, live from Studio A, at nine."
  }
 ],

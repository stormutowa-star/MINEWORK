 "lines": [
  {
   "t": 4.5,
   "d": 4.2,
   "who": "dot",
   "text": "We - we interrupt our program. This is Dot Kimball in Studio A."
  },
  {
   "t": 9.0,
   "d": 4.6,
   "who": "dot",
   "text": "There's a fire in our transmitter hall. Please - please don't telephone the station."
  },
  {
   "t": 14.0,
   "d": 5.0,
   "who": "dot",
   "text": "Arthur - Mr. Penrose - went in to shut the tower down. He's following the procedure."
  },
  {
   "t": 19.4,
   "d": 4.6,
   "who": "dot",
   "text": "He opened the coolant - valve three, it's on the card - but nothing's cooling."
  },
  {
   "t": 24.5,
   "d": 5.0,
   "who": "dot",
   "text": "We're staying on the air. Somebody has to tell you what's happening."
  },
  {
   "t": 30.0,
   "d": 4.0,
   "who": "dot",
   "text": "It's nine fourteen. The lights are going -"
  },
  {
   "t": 34.4,
   "d": 4.0,
   "who": "dot",
   "text": "This is WKVR, Channel 7, Halloway Falls. We -"
  }
 ],

 "lines": [
  {
   "t": 1.4,
   "d": 4.2,
   "who": "dot",
   "text": "It's time for Lucky Dial! Phones are ringing all over the valley..."
  },
  {
   "t": 6.0,
   "d": 4.6,
   "who": "dot",
   "text": "...and our lucky caller is Mrs. Eleanor Voss, of Pine Street!"
  },
  {
   "t": 11.0,
   "d": 4.0,
   "who": "voss",
   "text": "Oh my stars! Is this really the television?"
  },
  {
   "t": 15.5,
   "d": 5.0,
   "who": "dot",
   "text": "It is! Mrs. Voss, you've won a Futura Kitchen - the brand-new Model 63!"
  },
  {
   "t": 21.0,
   "d": 4.0,
   "who": "voss",
   "text": "A Model 63? I didn't know they'd made one!"
  },
  {
   "t": 25.5,
   "d": 4.0,
   "who": "dot",
   "text": "Nobody did until today! Stay with us for a first look."
  },
  {
   "t": 33.4,
   "d": 4.2,
   "who": "servo",
   "text": "GOOD EVENING. I AM THE NEW SERVO. I NOW FOLD LAUNDRY."
  },
  {
   "t": 38.0,
   "d": 5.0,
   "who": "announcer",
   "text": "Introducing the Futura Kitchen Model 63 - in showrooms this spring."
  },
  {
   "t": 43.5,
   "d": 3.8,
   "who": "announcer",
   "text": "Model 63. Because tomorrow can't wait."
  },
  {
   "t": 47.6,
   "d": 3.8,
   "who": "servo",
   "text": "FUTURA. TOMORROW, DELIVERED TODAY."
  }
 ],

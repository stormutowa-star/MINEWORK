 "lines": [
  {
   "t": 2.5,
   "d": 4.6,
   "who": "hal",
   "text": "Good evening. This is the Channel 7 Report for Tuesday, October twenty-third."
  },
  {
   "t": 7.5,
   "d": 5.0,
   "who": "hal",
   "text": "From Washington tonight: the Navy quarantine in the Caribbean remains in force."
  },
  {
   "t": 13.0,
   "d": 4.6,
   "who": "hal",
   "text": "Officials ask families to stay calm and keep to their routines."
  },
  {
   "t": 18.0,
   "d": 5.0,
   "who": "hal",
   "text": "Locally, a cold front moves in overnight. Frost likely by Thursday morning."
  },
  {
   "t": 23.5,
   "d": 5.0,
   "who": "hal",
   "text": "Clear skies Thursday evening - good news for WKVR's Skyhook demonstration."
  },
  {
   "t": 29.0,
   "d": 5.0,
   "who": "hal",
   "text": "Guests from Futura Corporation will watch a single-hop telecast, coast to coast."
  },
  {
   "t": 34.5,
   "d": 5.2,
   "who": "hal",
   "text": "Station manager Walter Brandt says the tower will operate within its licensed power."
  },
  {
   "t": 40.0,
   "d": 4.8,
   "who": "hal",
   "text": "That's the Report. Goodnight, and keep your sets tuned to Channel 7."
  }
 ],

 "lines": [
  {
   "t": 1.0,
   "d": 4.0,
   "who": "dot",
   "text": "Good morning, Halloway Falls! It's Tuesday, the twenty-third of October."
  },
  {
   "t": 5.2,
   "d": 4.0,
   "who": "dot",
   "text": "A chilly one, so bundle up the little ones before the school bus."
  },
  {
   "t": 9.6,
   "d": 4.6,
   "who": "dot",
   "text": "The Grange fair opens in Delmar on Saturday. Pie entries close Friday noon."
  },
  {
   "t": 14.6,
   "d": 4.8,
   "who": "dot",
   "text": "And Thursday morning, our own chief engineer Arthur Penrose joins me right here..."
  },
  {
   "t": 19.8,
   "d": 4.4,
   "who": "dot",
   "text": "...to tell us what his Skyhook tower is cooking up for our big Futura demonstration."
  },
  {
   "t": 24.6,
   "d": 4.6,
   "who": "dot",
   "text": "Mr. Brandt promises it'll all be done right by the book."
  },
  {
   "t": 29.6,
   "d": 5.0,
   "who": "dot",
   "text": "And one more thing - tomorrow our new color cameras arrive. Can you imagine?"
  },
  {
   "t": 35.0,
   "d": 4.6,
   "who": "dot",
   "text": "Halloway Today, in living color. Thursday morning, eight o'clock sharp."
  },
  {
   "t": 40.2,
   "d": 5.0,
   "who": "dot",
   "text": "Until then, this is Dot Kimball saying: keep your antenna pointed at tomorrow!"
  }
 ],
